direction: down

title: {
  shape: text
  label: |md
    # QIceRadar Data Index Pipeline
  |
  style.font-size: 32
}

# ============================================================
# Parallel initial steps: gpkg setup and index generation
# ============================================================
initial: {
  label: ""
  style.fill: transparent
  style.stroke-width: 0
  direction: right

  # ---- LEFT TRACK: GeoPackage Setup ----
  gpkg_track: {
    label: ""
    style.fill: transparent
    style.stroke-width: 0
    direction: down

    step1: {
      label: "Step 1: Initialize GeoPackage"
      style.fill: "#e8f4f8"

      script: {
        shape: hexagon
        label: initialize_gpkg.py
      }

      input: {
        shape: page
        label: empty.gpkg\n(template from geopackage.org)
      }

      output: {
        shape: cylinder
        label: |md
          qiceradar_{region}_index.gpkg

          Tables created & populated:
          * institutions (enum)
          * data_formats (enum)
          * download_methods (enum)

          Schema defined for:
          * campaigns
          * granules
        |
      }

      input -> script
      script -> output
    }

    step2: {
      label: "Step 2: Populate Campaign Metadata"
      style.fill: "#e8f0e8"

      script: {
        shape: hexagon
        label: populate_campaigns.py
      }

      input: {
        shape: page
        label: |md
          data/*_campaigns.yaml (manually created)
          * awi_campaigns.yaml
          * bas_campaigns.yaml
          * cresis_campaigns.yaml
          * kopri_campaigns.yaml
          * utig_campaigns.yaml
        |
      }

      output: {
        shape: cylinder
        label: |md
          index.gpkg (updated)

          Populated table:
          * campaigns (name, institution, citations)
        |
      }

      input -> script
      script -> output
    }

    step1 -> step2
  }

  # ---- RIGHT TRACK: Index Generation ----
  index_track: {
    label: "Generate Download Indices"
    style.fill: "#f0f0e0"

    note: {
      shape: text
      label: |md
        Some indices are generated by scripts;
        others are manually downloaded;
        others are created at download time from APIs
        (UTIG TDR, UTIG AAD, KOPRI -- no intermediate file).
      |
      style.font-size: 14
    }

    generate_cresis: {
      shape: hexagon
      label: generate_cresis_ku_index.py
    }

    generate_utig_nsidc: {
      shape: hexagon
      label: generate_utig_nsidc_index.py
    }

    cresis_server: {
      shape: cloud
      label: data.cresis.ku.edu
    }

    utig_url_lists: {
      shape: page
      label: |md
        data/UTIG/ (manually created)
        * nsidc_download_urls_hicars1.txt
        * nsidc_download_urls_hicars2.txt
      |
    }

    bas_csvs: {
      shape: page
      label: |md
        data/BAS/*.csv
        (manually downloaded from RAMADDA)
        * AGAP.csv, POLARGAP.csv, ...
      |
    }

    awi_files: {
      shape: page
      label: |md
        data/AWI/
        * dataset_*.txt (from Pangaea)
      |
    }

    generated_indices: {
      shape: page
      label: |md
        Generated index files:
        * data/cresis_granules.csv
        * data/UTIG/utig_nsidc_index.csv
      |
    }

    cresis_server -> generate_cresis: {label: scrape}
    generate_cresis -> generated_indices
    utig_url_lists -> generate_utig_nsidc
    generate_utig_nsidc -> generated_indices
  }
}

# ============================================================
# STEP 3: Download Data & Populate Granules
# ============================================================
step3_group: {
  label: ""
  style.fill: transparent
  style.stroke-width: 0
  direction: right

  step3: {
    label: "Step 3: Download Data & Populate Granules"
    style.fill: "#f4f0e0"

    note: {
      shape: text
      label: |md
        Most download scripts insert granule
        metadata directly into the gpkg
        during download (BAS, UTIG, AWI, KOPRI).
      |
      style.font-size: 14
    }

    servers: {
      shape: cloud
      label: |md
        Remote data servers
      |
    }

    input_indices: {
      shape: page
      label: |md
        Index files
        (see detail)
      |
    }

    scripts: {
      shape: hexagon
      label: |md
        download_*.py
      |
    }

    output_radargrams: {
      shape: page
      label: |md
        ~/RadarData/{region}/{inst}/{campaign}/...
        (radargram files)
      |
    }

    output_gpkg: {
      shape: cylinder
      label: |md
        index.gpkg (updated)

        Granules table populated
        (BAS, UTIG, AWI, KOPRI inserted
        directly during download)
      |
    }

    input_indices -> scripts
    servers -> scripts
    scripts -> output_radargrams
    scripts -> output_gpkg
  }

  detail: {
    label: "Download Script Details"
    style.fill: "#faf8f0"
    style.stroke: "#ccc"

    bas: {
      shape: sql_table
      label: download_bas.py
      index_file: "data/BAS/\\{CAMPAIGN\\}.csv (manual)"
      server: ramadda.data.bas.ac.uk
      method: wget
      output: .nc
      inserts_granules: yes
    }

    cresis_ku: {
      shape: sql_table
      label: download_cresis_ku.py
      index_file: "data/cresis_granules.csv (generated)"
      server: data.cresis.ku.edu
      method: wget
      output: .mat
      inserts_granules: "no -- use populate_granules.py"
    }

    cresis_nsidc: {
      shape: sql_table
      label: download_cresis_nsidc.py
      index_file: "data/NASA/*.csv"
      server: "NSIDC (Earthdata login)"
      method: HTTPS + auth
      output: .nc
      inserts_granules: yes
    }

    utig_nsidc: {
      shape: sql_table
      label: download_utig_nsidc.py
      index_file: "data/UTIG/utig_nsidc_index.csv (generated)"
      server: "NSIDC (Earthdata login)"
      method: HTTPS + auth
      output: .nc
      inserts_granules: yes
    }

    utig_tdr: {
      shape: sql_table
      label: download_utig_tdr.py
      index_file: "Dataverse API query (no file)"
      server: dataverse.tdl.org
      method: wget
      output: .nc
      inserts_granules: yes
    }

    utig_aad: {
      shape: sql_table
      label: download_utig_aad_oia.py
      index_file: "S3 list_objects (no file)"
      server: transfer.data.aad.gov.au
      method: boto3 / S3
      output: .nc
      inserts_granules: yes
    }

    awi_pangaea: {
      shape: sql_table
      label: download_awi_pangaea.py
      index_file: "data/AWI/dataset_*_files.txt (manual)"
      server: download.pangaea.de
      method: "curl (with tape-retry)"
      output: .nc
      inserts_granules: yes
    }

    ldeo: {
      shape: sql_table
      label: download_ldeo_agap_gambit.sh
      index_file: "HTTP index.html (recursive wget)"
      server: wonder.ldeo.columbia.edu
      method: wget -r
      output: .nc
      inserts_granules: no
    }
  }
}

# ============================================================
# STEP 3b: Populate CReSIS Granules (post-download)
# ============================================================
step3b: {
  label: "Step 3b: Populate CReSIS Granules (post-download)"
  style.fill: "#f4ece0"

  note: {
    shape: text
    label: |md
      CReSIS KU is the exception:
      granules are populated *after* download
      so that actual filesizes can be recorded.
    |
    style.font-size: 14
  }

  script: {
    shape: hexagon
    label: populate_granules.py
  }

  input_csv: {
    shape: page
    label: data/cresis_granules.csv
  }

  input_files: {
    shape: page
    label: |md
      Downloaded CReSIS radargrams
      (used to get filesizes)
    |
  }

  output: {
    shape: cylinder
    label: |md
      index.gpkg (updated)

      CReSIS granules added
      with actual filesizes
    |
  }

  input_csv -> script
  input_files -> script: {label: filesize}
  script -> output
}

# ============================================================
# STEP 4+5: Extract & Subsample Tracklines
# ============================================================
step4: {
  label: "Steps 4+5: Extract & Subsample Tracklines"
  style.fill: "#f0e8f4"

  script: {
    shape: hexagon
    label: |md
      extract_radargram_tracks.py
      (also: extract_bedmap_tracks.py,
             extract_icethk_tracks.py)
    |
  }

  input: {
    shape: page
    label: |md
      ~/RadarData/{region}/{inst}/{campaign}/...
      (radargram files: .nc, .mat, .h5)
    |
  }

  processing: {
    shape: text
    label: |md
      Processing steps:
      1. Parse lat/lon from each radargram
      2. Transform to map projection (PS71)
      3. Clean outliers for known-problem files
      4. Subsample with RDP (--epsilon 500m)
    |
  }

  output: {
    shape: page
    label: |md
      ~/RadarData/targ/{region}/{inst}/{campaign}/{segment}/{granule}.csv

      Columns: ps71_easting, ps71_northing
    |
  }

  input -> script
  script -> processing: {style.stroke-dash: 3}
  script -> output
}

# ============================================================
# STEP 6: Add Tracklines to Database
# ============================================================
step6: {
  label: "Step 6: Create GeoPackage Index"
  style.fill: "#f4e8e0"

  script: {
    shape: hexagon
    label: create_geopackage_index.py
  }

  input_tracks: {
    shape: page
    label: |md
      ~/RadarData/targ/.../*.csv
      (subsampled ground tracks)
    |
  }

  input_icethk: {
    shape: page
    label: |md
      ~/RadarData/targ/icethk/.../*.csv
      (ice thickness point data)
    |
  }

  input_gpkg: {
    shape: cylinder
    label: index.gpkg\n(from steps 1-3)
  }

  output: {
    shape: cylinder
    label: |md
      index.gpkg (updated)

      New per-campaign tables added:
      * geometry (LineString or MultiPoint)
      * name, region, institution
      * campaign, segment, granule
      * relative_path, availability

      Updated GPKG required tables:
      * gpkg_contents
      * gpkg_geometry_columns
      * gpkg_spatial_ref_sys
    |
  }

  input_tracks -> script
  input_icethk -> script
  input_gpkg -> script
  script -> output
}

# ============================================================
# STEP 7: Style for QGIS
# ============================================================
step7: {
  label: "Step 7: Style for QGIS"
  style.fill: "#e0f0e8"

  script: {
    shape: hexagon
    label: style_geopackage_index.py
  }

  note: {
    shape: text
    label: |md
      Requires QGIS Python environment:
      * QGIS_PREFIX_PATH
      * PYTHONPATH includes QGIS
    |
    style.font-size: 14
  }

  input: {
    shape: cylinder
    label: |md
      qiceradar_{region}_index.gpkg
      (with geometry layers)
    |
  }

  output: {
    shape: page
    label: |md
      qiceradar_{region}_index.qlr

      QGIS Layer Definition file:
      * Layer hierarchy
      * Symbology by availability
      * Color scheme
    |
  }

  input -> script
  script -> output
  note -> script: {style.stroke-dash: 3; style.stroke: "#999"}
}

# ============================================================
# FINAL OUTPUT
# ============================================================
release: {
  label: "Releasable Artifacts"
  style.fill: "#d4edda"
  style.stroke: "#28a745"
  style.bold: true

  antarctic_gpkg: {
    shape: page
    label: qiceradar_antarctic_index.gpkg
  }
  antarctic_qlr: {
    shape: page
    label: qiceradar_antarctic_index.qlr
  }
  arctic_gpkg: {
    shape: page
    label: qiceradar_arctic_index.gpkg
  }
  arctic_qlr: {
    shape: page
    label: qiceradar_arctic_index.qlr
  }
}

# ============================================================
# CONNECTIONS BETWEEN STEPS
# ============================================================
title -> initial: {style.stroke-width: 0}
initial.gpkg_track -> step3_group.step3: {label: gpkg for granule insertion}
initial.index_track -> step3_group.step3: {label: index files feed downloads}
step3_group.step3 -> step3b: {label: CReSIS files downloaded}
step3_group.step3 -> step4: {label: radargram files}
step3b -> step4: {style.stroke-width: 0}
step4 -> step6
initial.gpkg_track -> step6: {
  label: gpkg carries through
  style.stroke-dash: 5
}
step6 -> step7
step7 -> release
